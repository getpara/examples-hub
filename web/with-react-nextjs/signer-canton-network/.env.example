NEXT_PUBLIC_PARA_API_KEY=
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Canton (server-only — never prefix with NEXT_PUBLIC_)
# Defaults below target Splice LocalNet's app-user node.
LEDGER_API_URL=http://localhost:2975
VALIDATOR_API_URL=http://localhost:2903/api/validator
VALIDATOR_AUDIENCE=https://canton.network.global
AUTH_USER_ID=ledger-api-user
AUTH_ADMIN_ID=ledger-api-user
AUTH_UNSAFE_SECRET=unsafe

# Token-standard transfer factory registry. Optional for LocalNet (the SDK's
# localNetStaticConfig.LOCALNET_REGISTRY_API_URL is used by default). Set
# this for hosted Canton deployments — typically the validator's scan-proxy:
# https://<your-validator>/api/validator/v0/scan-proxy
# TRANSFER_FACTORY_REGISTRY_URL=
