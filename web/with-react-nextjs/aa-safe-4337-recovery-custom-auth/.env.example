# Public API key for the app configured in the Para Developer Portal, with passkeys and EVM wallets enabled.
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key

# Para environment for that API key.
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Pimlico API key for the sponsored Safe user operations.
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key

# Optional Sepolia RPC URL. Defaults to the public node below.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
