# Para passkey EVM API key for the recovery guardian wallet
# Get your API key from https://developer.getpara.com and enable passkeys + EVM wallets
NEXT_PUBLIC_PARA_API_KEY=your_passkey_evm_para_api_key_here
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Pimlico Configuration
# Get your API key from https://dashboard.pimlico.io
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key_here

# Optional RPC override
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
