# Public API key for the app configured in the Para Developer Portal.
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key

# Para environment for that API key. Bridging on mainnet needs a production key.
NEXT_PUBLIC_PARA_ENVIRONMENT=PROD

# Optional Base mainnet RPC URL. Defaults to https://mainnet.base.org.
NEXT_PUBLIC_BASE_RPC_URL=

# Optional Arc mainnet RPC URL. Defaults to https://rpc.mainnet.arc.io.
NEXT_PUBLIC_ARC_RPC_URL=
