# Para SDK Configuration
# Get your API key from https://developer.getpara.com
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key_here
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Pimlico Configuration
# Get your API key from https://dashboard.pimlico.io
NEXT_PUBLIC_PIMLICO_API_KEY=your_pimlico_api_key_here

# Pimlico Sponsorship Policy
# Create a sponsorship policy at https://dashboard.pimlico.io/sponsorship-policies
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY_ID=your_sponsorship_policy_id_here
