# Para SDK Configuration
# Get your API key from https://para.io
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key_here
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Alchemy Configuration
# Create an Alchemy app at https://dashboard.alchemy.com
# Generate RPC URL format: https://eth-sepolia.g.alchemy.com/v2/{YOUR_API_KEY}
NEXT_PUBLIC_ALCHEMY_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# Alchemy Gas Manager Configuration
# Create a gas policy at https://dashboard.alchemy.com/gas-manager
# Leave empty for non-sponsored transactions
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id_here

# WalletConnect Configuration (Optional)
# Get your project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here