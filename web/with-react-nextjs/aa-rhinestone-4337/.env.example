# Para SDK Configuration
# Get your API key from https://developer.getpara.com
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key_here
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Rhinestone Configuration
# Get your API key from Rhinestone for orchestrator
# This is kept on the server side (no NEXT_PUBLIC_ prefix) for security
RHINESTONE_API_KEY=your_rhinestone_api_key_here

# App URL for cross-chain orchestration (defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
