# Public API key for the app configured in the Para Developer Portal.
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key

# Para environment for that API key.
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Rhinestone orchestrator API key. Server only: the proxy route adds it to each request.
RHINESTONE_API_KEY=your_rhinestone_api_key

# Base URL for the orchestrator proxy during server rendering. The browser uses its own origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
