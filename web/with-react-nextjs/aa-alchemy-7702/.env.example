# Public API key for the app configured in the Para Developer Portal.
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key

# Para environment for that API key.
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# Alchemy API key from https://dashboard.alchemy.com
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Alchemy Gas Manager policy ID from https://dashboard.alchemy.com/gas-manager
NEXT_PUBLIC_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id
