# Para API key for a partner with CUSTOM_OIDC enabled by Para (this is not self-serve in the portal).
# See https://developer.getpara.com and contact Para to enable Custom OIDC for your partner.
NEXT_PUBLIC_PARA_API_KEY=your_para_api_key
# Match the environment where your CUSTOM_OIDC partner is configured (this demo's partner is on DEV).
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA
# Optional: private Sepolia RPC endpoint for the faucet + send-transaction demo.
# Defaults to a public node (https://ethereum-sepolia-rpc.publicnode.com) when unset.
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
