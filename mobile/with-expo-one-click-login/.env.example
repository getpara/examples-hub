# Para API Key
# Get your API key from https://developer.getpara.com
EXPO_PUBLIC_PARA_API_KEY=your_api_key_here

# Alchemy Account Abstraction (optional — needed for Smart Account screen)
# Get your API key from https://dashboard.alchemy.com
# Create a gas policy at Dashboard > Gas Manager > Create Policy (Sepolia)
EXPO_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
EXPO_PUBLIC_ALCHEMY_GAS_POLICY_ID=your_gas_policy_id_here
