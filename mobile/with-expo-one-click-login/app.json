{
  "expo": {
    "name": "Para One-Click Login",
    "slug": "para-one-click-login",
    "version": "1.0.0",
    "scheme": "para-one-click",
    "platforms": [
      "ios",
      "android"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.getpara.oneclickexample",
      "appleTeamId": "FF9U73RS48"
    },
    "android": {
      "package": "com.getpara.oneclickexample",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3b19a0ec-9f43-4239-b136-4cc15c17061d"
      }
    },
    "owner": "getpara"
  }
}
