{
  "name": "@getpara/graz-connector",
  "version": "2.0.0-alpha.71",
  "sideEffects": false,
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && node ./scripts/build.mjs && yarn build:types",
    "build:types": "rm -rf dist/types && tsc --module esnext --declarationDir dist/types --emitDeclarationOnly --declaration"
  },
  "dependencies": {
    "@getpara/cosmjs-v0-integration": "2.0.0-alpha.71",
    "@getpara/web-sdk": "2.0.0-alpha.71"
  },
  "devDependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "@keplr-wallet/types": "^0.12.156",
    "cosmjs-types": "^0.9.0",
    "graz": "^0.4.1",
    "typescript": "5.1.6"
  },
  "peerDependencies": {
    "@cosmjs/amino": ">=0.32.4",
    "@cosmjs/encoding": ">=0.32.4",
    "@cosmjs/proto-signing": ">=0.32.4",
    "@cosmjs/stargate": ">=0.32.4",
    "@cosmjs/tendermint-rpc": ">=0.32.4",
    "@keplr-wallet/types": ">=0.12.156",
    "cosmjs-types": ">=0.8.0",
    "graz": ">=0.4.1"
  }
}
