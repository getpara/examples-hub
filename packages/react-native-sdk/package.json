{
  "name": "@getpara/react-native-wallet",
  "description": "Para Wallet for React Native",
  "version": "2.0.0-alpha.43",
  "author": "Para Team <hello@getpara.com> (https://getpara.com)",
  "dependencies": {
    "@getpara/core-sdk": "2.0.0-alpha.43",
    "@getpara/user-management-client": "2.0.0-alpha.43",
    "@getpara/web-sdk": "2.0.0-alpha.43",
    "@peculiar/webcrypto": "^1.5.0",
    "@ungap/structured-clone": "1.3.0",
    "node-forge": "1.3.1",
    "react-native-url-polyfill": "2.0.0",
    "text-encoding": "0.7.0"
  },
  "devDependencies": {
    "@craftzdog/react-native-buffer": "6.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@types/node-forge": "1.3.1",
    "@types/react": "^18.0.31",
    "@types/react-native": "0.70.0",
    "@types/text-encoding": "0.0.39",
    "react-native-keychain": "10.0.0",
    "react-native-modpow": "1.1.0",
    "react-native-passkey": "3.1.0",
    "react-native-quick-base64": "2.1.2",
    "react-native-quick-crypto": "0.7.12",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./shim": {
      "default": "./dist/shim.js"
    },
    "./dist/shim.js": {
      "default": "./dist/shim.js"
    }
  },
  "files": [
    "dist",
    "src",
    "ios",
    "android",
    "cpp",
    "*.podspec",
    "signer.xcframework",
    "signer.aar"
  ],
  "homepage": "https://getpara.com",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@craftzdog/react-native-buffer": "*",
    "@react-native-async-storage/async-storage": "*",
    "react": "*",
    "react-native": "*",
    "react-native-keychain": "*",
    "react-native-modpow": "*",
    "react-native-passkey": "*",
    "react-native-quick-base64": "*",
    "react-native-quick-crypto": "*",
    "readable-stream": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native": {
    ".": "./dist/index.js",
    "./shim": "./dist/shim.js",
    "./dist/shim.js": "./dist/shim.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "compile-signer": "bash ./scripts/compileSigner.sh",
    "test": "vitest run --coverage"
  },
  "sideEffects": [
    "./dist/shim.js"
  ],
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "shim": [
        "./dist/shim.d.ts"
      ],
      "dist/shim.js": [
        "./dist/shim.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  }
}
