{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "lib": ["dom", "es6"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "declarationDir": "./dist/types",
    "declaration": true,
    "resolveJsonModule": true
  },
  "include": ["./src", "./vite.config.ts"],
  "exclude": ["node_modules"]
}
