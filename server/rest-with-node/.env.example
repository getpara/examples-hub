# Copy this file to .env and fill in your values before running the server.

# Your Para REST API key from https://developer.getpara.com
PARA_API_KEY=sk_beta_xxxxxx

# Your Para Secret API Key from the Developer Portal (different from PARA_API_KEY).
# Required to verify caller sessions before any wallet-scoped route runs — see
# https://docs.getpara.com/v2/server/guides/sessions#session-validation
PARA_SECRET_API_KEY=sec_beta_xxxxxx
