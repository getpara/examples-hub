{
  "name": "sdk-dependency-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Tool to check vulnerable dependencies in SDK packages",
  "main": "index.js",
  "workspaces": {
    "nohoist": [
      "**"
    ]
  },
  "scripts": {
    "check-vulns": "yarn add --dev ts-node typescript @types/node && ts-node checkVulnerabilities.ts"
  },
  "dependencies": {
    "@getpara/core-components": "file:../../packages/core-components",
    "@getpara/core-sdk": "file:../../packages/core-sdk",
    "@getpara/cosmjs-v0-integration": "file:../../packages/cosmjs-v0-integration",
    "@getpara/cosmos-wallet-connectors": "file:../../packages/cosmos-wallet-connectors",
    "@getpara/ethers-v5-integration": "file:../../packages/ethers-v5-integration",
    "@getpara/ethers-v6-integration": "file:../../packages/ethers-v6-integration",
    "@getpara/evm-wallet-connectors": "file:../../packages/evm-wallet-connectors",
    "@getpara/react-common": "file:../../packages/react-common",
    "@getpara/react-components": "file:../../packages/react-components",
    "@getpara/react-native-wallet": "file:../../packages/react-native-sdk",
    "@getpara/react-sdk": "file:../../packages/react-sdk",
    "@getpara/server-sdk": "file:../../packages/server-sdk",
    "@getpara/solana-wallet-connectors": "file:../../packages/solana-wallet-connectors",
    "@getpara/solana-web3.js-v1-integration": "file:../../packages/solana-web3js-v1-integration",
    "@getpara/user-management-client": "file:../../packages/user-management-client",
    "@getpara/viem-v1-integration": "file:../../packages/viem-v1-integration",
    "@getpara/viem-v2-integration": "file:../../packages/viem-v2-integration",
    "@getpara/wagmi-v1-integration": "file:../../packages/wagmi-v1-integration",
    "@getpara/wagmi-v2-integration": "file:../../packages/wagmi-v2-integration",
    "@getpara/web-sdk": "file:../../packages/web-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
