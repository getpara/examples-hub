# GitHub Secrets Required:
# - PARA_API_KEY_BETA: Your Para API key for BETA environment
# - PARA_API_KEY_SANDBOX: Your Para API key for SANDBOX environment (optional)
# - WALLET_CONNECT_PROJECT_ID: Your WalletConnect project ID (optional)

# Base environment variables
PARA_API_KEY_BETA=your_api_key_here
PARA_ENVIRONMENT=BETA

# Framework-specific environment variables (auto-populated in CI from secrets)
VITE_PARA_API_KEY=your_api_key_here
VITE_PARA_ENVIRONMENT=BETA
NEXT_PUBLIC_PARA_API_KEY=your_api_key_here
NEXT_PUBLIC_PARA_ENVIRONMENT=BETA

# WalletConnect project IDs (optional)
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Node.js memory allocation
NODE_OPTIONS="--max-old-space-size=4096"