{
  "name": "capsule-js-bridge",
  "version": "0.8.0",
  "main": "src/index.tsx",
  "private": true,
  "dependencies": {
    "@metamask/eth-sig-util": "^7.0.0",
    "@metamask/utils": "^8.1.0",
    "@usecapsule/user-management-client": "1.4.1",
    "@usecapsule/web-sdk": "1.8.0",
    "base64url": "^3.0.1",
    "cbor-web": "^9.0.2",
    "node-forge": "^1.3.1",
    "react": "18.2.0",
    "react-circular-progressbar": "2.1.0",
    "react-dom": "18.2.0",
    "react-qr-code": "2.0.11",
    "react-scripts": "5.0.1",
    "react-use": "17.4.0",
    "typescript": "4.9.5",
    "webpack": "5.88.2"
  },
  "scripts": {
    "start": "DISABLE_ESLINT_PLUGIN=true PORT=3004 craco start",
    "build": "DISABLE_ESLINT_PLUGIN=true craco build",
    "serve-build": "PORT=3004 serve -s build",
    "deploy-s3": "yarn && yarn build && aws s3 sync build/ s3://$REACT_BUCKET_NAME --acl public-read --profile $REACT_APP_ENV --delete",
    "deploy-sandbox": "REACT_APP_ENV=sandbox REACT_BUCKET_NAME=capsule-sandbox-js-bridge yarn deploy-s3",
    "deploy-beta": "REACT_APP_ENV=beta REACT_BUCKET_NAME=capsule-beta-js-bridge yarn deploy-s3",
    "deploy-prod": "REACT_APP_ENV=prod REACT_BUCKET_NAME=capsule-prod-js-bridge yarn deploy-s3"
  },
  "devDependencies": {
    "@craco/craco": "7.1.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "crypto-browserify": "^3.12.0",
    "serve": "^14.2.1",
    "stream-browserify": "^3.0.0",
    "ts-loader": "9.4.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.1"
  },
  "browserslist": [
    "chrome > 52",
    "opera > 39",
    "edge > 14",
    "firefox > 52",
    "safari > 10.1",
    "not dead",
    "not op_mini all"
  ]
}
