{
  "name": "capsule-js-bridge",
  "version": "1.3.1",
  "main": "src/index.tsx",
  "private": true,
  "dependencies": {
    "@getpara/ethers-v6-integration": "1.3.1",
    "@getpara/user-management-client": "1.3.1",
    "@getpara/web-sdk": "1.3.1",
    "@metamask/eth-sig-util": "7.0.3",
    "@metamask/utils": "^8.1.0",
    "base64url": "^3.0.1",
    "cbor-web": "^9.0.2",
    "ethers": "6.x",
    "node-forge": "^1.3.1",
    "react": "18.2.0",
    "react-circular-progressbar": "2.1.0",
    "react-dom": "18.2.0",
    "react-qr-code": "2.0.11",
    "react-use": "17.4.0",
    "typescript": "4.9.5",
    "webpack": "5.88.2"
  },
  "scripts": {
    "start": "vite",
    "build": "rm -rf build && tsc && vite build",
    "preview": "vite preview",
    "deploy-s3": "yarn && yarn build && aws s3 sync build/ s3://$VITE_BUCKET_NAME --profile $VITE_ENV --delete",
    "deploy-sandbox": "VITE_ENV=sandbox VITE_BUCKET_NAME=capsule-sandbox-js-bridge yarn deploy-s3",
    "deploy-beta": "VITE_ENV=beta VITE_BUCKET_NAME=capsule-beta-js-bridge yarn deploy-s3",
    "deploy-prod": "VITE_ENV=prod VITE_BUCKET_NAME=capsule-prod-js-bridge yarn deploy-s3"
  },
  "devDependencies": {
    "@craco/craco": "7.1.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "18.0.31",
    "@types/react-dom": "18.0.11",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "crypto-browserify": "^3.12.0",
    "react-scripts": "5.0.1",
    "serve": "^14.2.1",
    "stream-browserify": "^3.0.0",
    "ts-loader": "9.4.2",
    "vite": "^5.3.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.1"
  },
  "browserslist": [
    "chrome > 52",
    "opera > 39",
    "edge > 14",
    "firefox > 52",
