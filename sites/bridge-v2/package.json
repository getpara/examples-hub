    "@getpara/user-management-client": "2.0.0-alpha.36",
    "@getpara/web-sdk": "2.0.0-alpha.36",
    "@metamask/eth-sig-util": "7.0.3",
    "@metamask/utils": "^8.1.0",
    "@solana/web3.js": "^1.98.0",
    "base64url": "^3.0.1",
