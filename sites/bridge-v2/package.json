  "main": "src/index.tsx",
  "private": true,
  "scripts": {
    "build": "rm -rf build && tsc && vite build",
    "deploy-beta": "VITE_ENV=beta VITE_BUCKET_NAME=capsule-beta-alpha-js-bridge-site yarn deploy-s3",
    "deploy-prod": "VITE_ENV=prod VITE_BUCKET_NAME=capsule-prod-alpha-js-bridge-site yarn deploy-s3",
    "deploy-s3": "yarn && yarn build && aws s3 sync dist/ s3://$VITE_BUCKET_NAME --profile $VITE_ENV --delete",
    "deploy-sandbox": "VITE_ENV=sandbox VITE_BUCKET_NAME=capsule-sandbox-alpha-js-bridge-site yarn deploy-s3",
    "preview": "vite preview",
    "start": "vite"
  }
}
