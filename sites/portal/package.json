{
  "name": "capsule-portal",
  "version": "2.0.0-alpha.0",
  "main": "src/index.tsx",
  "private": true,
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@chakra-ui/system": "^2.6.2",
    "@getpara/react-common": "2.0.0-alpha.0",
    "@getpara/react-components": "2.0.0-alpha.0",
    "@getpara/react-sdk": "2.0.0-alpha.0",
    "@getpara/user-management-client": "2.0.0-alpha.0",
    "@getpara/web-sdk": "2.0.0-alpha.0",
    "@sentry/react": "^9.1.0",
    "axios": "^1.7.7",
    "framer-motion": "^11.2.13",
    "libphonenumber-js": "^1.11.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-qr-code": "2.0.11",
    "react-router-dom": "^6.24.1",
    "styled-components": "^6.1.8",
    "usehooks-ts": "^3.1.0"
  },
  "scripts": {
    "dev": "DISABLE_ESLINT_PLUGIN=true VITE_ENVIRONMENT=dev vite --port 3003 --host",
    "start": "DISABLE_ESLINT_PLUGIN=true VITE_ENVIRONMENT=dev vite --port 3003 --host",
    "build": "rm -rf dist && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start-e2e": "DISABLE_ESLINT_PLUGIN=true VITE_IS_E2E=true VITE_ENVIRONMENT=sandbox VITE_CAPSULE_API_KEY=7a455d14ff0128658ef9d224140a9ff2 vite --port 3003",
    "check-wasm-file-exists": "test -f ./public/static/js/main.wasm || (echo 'public/static/js/main.wasm file does not exist!'; exit 1)",
    "check-mpc-worker-file-exists": "test -f ./public/static/js/mpcWorker-bundle.js || (echo 'public/static/js/mpcWorker-bundle.js file does not exist!'; exit 1)",
    "deploy-s3": "yarn && yarn build && yarn check-wasm-file-exists && yarn check-mpc-worker-file-exists && aws s3 sync dist/ s3://capsule-$VITE_ENVIRONMENT-web-portal --profile $VITE_ENVIRONMENT",
    "deploy-sandbox": "VITE_CAPSULE_API_KEY=7a455d14ff0128658ef9d224140a9ff2 VITE_ENVIRONMENT=sandbox yarn deploy-s3",
    "deploy-beta": "VITE_CAPSULE_API_KEY=b755f6b3b60d27f4bcdada6f7fc8e463 VITE_ENVIRONMENT=beta yarn deploy-s3",
    "deploy-prod": "VITE_CAPSULE_API_KEY=60f30be5de2332705486a8570c6c7873 VITE_ENVIRONMENT=prod yarn deploy-s3",
    "setup-worker": "cd ../../../go-sdk && GOOS=js GOARCH=wasm go build -o ../web-sdk/sites/portal/public/static/js/main.wasm wasm/main.go && cd ../web-sdk/packages/web-sdk && yarn && yarn build && cd ../../sites/portal"
  },
  "devDependencies": {
    "browserify-zlib": "^0.2.0",
    "cosmjs-types": "0.9.0",
    "crypto-browserify": "^3.12.0",
    "react-scripts": "^5.0.1",
    "semver": "^7.5.4",
    "stream-browserify": "3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.4",
    "url": "^0.11.3",
    "vite": "^5.3.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "webpack": "5.76.3",
    "webpack-cli": "5.0.1",
    "webpack-dev-server": "4.13.1"
  },
  "resolutions": {
    "styled-components": "^6"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
