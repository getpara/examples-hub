{
  "name": "modal-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && vite build",
    "deploy-prod": "yarn && yarn build && aws s3 sync dist/ s3://capsule-prod-demo-site --profile prod --delete",
    "deploy-sandbox": "yarn && yarn build && aws s3 sync dist/ s3://capsule-sandbox-demo-site --profile sandbox --delete",
    "dev": "vite --host",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "sort-imports": "eslint --fix src/**/*.{ts,tsx}"
  },
  "resolutions": {
    "styled-components": "^5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "7.0.0",
    "@dnd-kit/sortable": "8.0.0",
    "@floating-ui/react": "^0.26.24",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@usecapsule/cosmos-wallet-connectors": "1.1.0",
    "@usecapsule/evm-wallet-connectors": "1.1.0",
    "@usecapsule/react-components": "3.6.0",
    "@usecapsule/react-sdk": "4.1.0",
    "@usecapsule/solana-wallet-connectors": "1.1.0",
    "imask": "^7.6.1",
    "jotai": "^2.10.0",
    "lodash.clonedeep": "^4.5.0",
    "lodash.merge": "^4.6.2",
    "loglevel": "^1.9.2",
    "qs": "^6.13.0",
    "react": "^18.2.0",
    "react-colorful": "5.6.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "4.0.13",
    "react-hook-form": "^7.51.5",
    "react-router-dom": "^6.23.1",
    "shiki": "^1.17.7",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.2.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
