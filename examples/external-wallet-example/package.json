{
  "name": "capsule-external-wallet-example",
  "private": true,
  "version": "2.0.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "rm -rf build && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy-s3": "yarn && yarn build && aws s3 sync dist/ s3://$VITE_BUCKET_NAME --acl public-read --delete",
    "deploy-sandbox": "VITE_ENVIRONMENT=SANDBOX VITE_BUCKET_NAME=capsule-rainbowkit-playground VITE_PARA_API_KEY=8ee2d015fbc6062a6e30bdc472f2946c yarn deploy-s3",
    "postinstall": "yarn graz -g"
  },
  "dependencies": {
    "@cosmjs/cosmwasm-stargate": "<=0.31.3",
    "@cosmjs/launchpad": "*",
    "@cosmjs/proto-signing": "<=0.31.3",
    "@cosmjs/stargate": "<=0.33.1",
    "@cosmjs/tendermint-rpc": "<=0.31.3",
    "@getpara/cosmos-wallet-connectors": "2.0.0-alpha.0",
    "@getpara/evm-wallet-connectors": "2.0.0-alpha.0",
    "@getpara/graz": "^1.0.0-dev.2",
    "@getpara/react-components": "2.0.0-alpha.0",
    "@getpara/react-sdk": "2.0.0-alpha.0",
    "@getpara/solana-wallet-connectors": "2.0.0-alpha.0",
    "@noble/curves": "1.5.0",
    "@solana-mobile/wallet-adapter-mobile": "^2.1.3",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-walletconnect": "^0.1.16",
    "@solana/web3.js": "^1.98.0",
    "@tanstack/react-query": "^5.24.1",
    "bs58": "6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^6.1.8",
    "viem": "^2.24.2",
    "wagmi": "^2.14.16",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "eslint-plugin-storybook": "^0.8.0",
    "starknet": "6.11.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vite-plugin-node-polyfills": "^0.22.0"
  },
  "resolutions": {
    "styled-components": "^6"
  }
}
