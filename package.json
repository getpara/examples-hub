{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "sites/*",
    "examples/*",
    "workers/*"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --config eslint.config.js --cache --fix"
    ]
  },
  "scripts": {
    "setup-worker": "lerna run setup-worker --scope=capsule-portal && cd workers/mpc-worker && yarn build && cd ../..",
    "build": "lerna run build --parallel",
    "lint": "eslint --config eslint.config.js --fix './**/*.{js,jsx,ts,tsx}'",
    "start": "lerna run start --scope=capsule-legacy-example --scope=capsule-portal",
    "start-server": "lerna run start --scope=capsule-server-example",
    "start-bridge": "lerna run start --scope=capsule-js-bridge",
    "lerna-version": "lerna version",
    "lerna-publish": "lerna publish from-package --no-private",
    "prepare": "husky",
    "test": "lerna run test"
  },
  "devDependencies": {
    "@stencil-community/eslint-plugin": "^0.8.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.0.11",
    "lerna": "^8.1.2",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "vitest": "^1.6.0"
  },
  "version": "0.0.0"
}
