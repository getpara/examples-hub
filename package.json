{
  "name": "root",
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@playwright/test": "1.55.1",
    "@stencil-community/eslint-plugin": "^0.10.0",
    "@synthetixio/synpress": "4.1.1",
    "@tanstack/eslint-plugin-query": "^5.52.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/coverage-v8": "^3.0.9",
    "esbuild": "0.24.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-storybook": "^0.8.0",
    "glob": "^11.0.1",
    "lerna": "^8.2.1",
    "lint-staged": "^15.2.2",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.5.2",
    "ts-node": "^10.9.2",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --config eslint.config.js --cache --fix"
    ]
  },
  "private": true,
  "resolutions": {
    "axios": "^1.8.4",
    "cross-spawn": "^7.0.6",
    "elliptic": "^6.6.1",
    "nth-check": "^2.1.1"
  },
  "scripts": {
    "alpha-publish": "lerna publish from-package --no-private --dist-tag alpha",
    "alpha-release": "node scripts/alpha-publish-workflow.mjs",
    "alpha-version": "lerna version prerelease --preid alpha --no-push --no-git-tag-version && yarn gen-changelog-alpha",
    "build": "lerna run build --parallel --concurrency 2",
    "postinstall": "yarn graz -g && patch-package && bash scripts/setup-examples-hub.sh",
    "build:dev": "yarn link-shared-symlink && lerna run build --scope=@getpara/* --scope=capsule-mpc-worker --scope=capsule-mpc-worker-server --concurrency 4",
    "check-bundle-size": "node scripts/check-bundle-size.js",
    "clean": "find . \\( -name \"node_modules\" -o -name \"dist\" -o -name \"build\" -o -name \".nx\" \\) -type d -prune -exec rm -rf {} +",
    "dev": "yarn build:dev; concurrently \"yarn start\" \"yarn dev:external-wallet-example\" \"yarn watch:affected\"",
    "dev:external-wallet-example": "cd examples/external-wallet-example && yarn dev",
    "e2e:cache-wallets": "synpress e2e/external-wallets/wallet-setup --headless",
    "e2e:legacy": "playwright test --config=e2e/legacy/playwright.config.ts",
    "e2e:examples-hub": "ts-node e2e/examples-hub/runner.ts",
    "e2e:stress-test": "playwright test --config=e2e/stress-test/playwright.config.ts; playwright merge-reports --reporter html ./blob-report",
    "e2e:stress-test:clean": "rm -rf blob-report playwright-report",
    "e2e:external-wallets": "playwright test --config=e2e/external-wallets/playwright.config.ts",
    "gen-changelog": "node ./scripts/gen-changelog.mjs --branch main",
    "gen-changelog-alpha": "node ./scripts/gen-changelog.mjs --branch 2.0.0-alpha --alpha",
    "lerna-publish": "false && lerna publish from-package --no-private",
    "lerna-publish-dev": "lerna publish preminor --preid dev --dist-tag dev",
    "lerna-version": "false && lerna version --tag-version-prefix=\"getpara-\" && yarn gen-changelog",
    "lint": "eslint --config eslint.config.js .",
    "lint-fix": "eslint --config eslint.config.js --fix .",
    "rm-getpara-yarn-links": "rm -rf ~/.config/yarn/link/@getpara",
    "link-shared-symlink": "node scripts/link-shared-symlink.js",
    "unlink-shared-symlink": "node scripts/unlink-shared-symlink.js",
    "update-shared-version": "node scripts/update-shared-version.js",
    "setup-worker": "yarn link-shared-symlink && lerna run setup-worker --scope=para-portal && cd workers/mpc-worker && yarn build && cd ../..",
    "sync-examples-hub": "bash scripts/sync-from-examples-hub.sh",
    "start": "lerna run start --scope=capsule-legacy-example --scope=para-portal",
    "start-bridge": "lerna run start --scope=capsule-js-bridge",
    "start-demo": "lerna run dev --scope=modal-builder",
    "start-dev-portal": "yarn link-shared-symlink && lerna run dev --scope=developer-portal",
    "start-server": "lerna run start --scope=capsule-server-example",
    "test": "lerna run test",
    "watch:affected": "node scripts/watch-affected.js"
  },
  "workspaces": [
    "packages/*",
    "sites/*",
    "examples/*",
    "!examples-hub",
    "!examples-hub/**",
    "workers/*"
  ],
  "packageManager": "yarn@1.22.22",
  "version": "0.0.0"
}
