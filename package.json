{
  "name": "examples-hub",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "^22.15.21",
    "dotenv": "^17.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "install:all": "tsx scripts/install-all-dependencies.ts",
    "build:all": "tsx scripts/build-all-projects.ts",
    "lint:all": "tsx scripts/lint-all-projects.ts",
    "typecheck:all": "tsx scripts/typecheck-all-projects.ts",
    "web:install": "tsx scripts/install-web.ts",
    "web:lint": "tsx scripts/lint-web.ts",
    "web:typecheck": "tsx scripts/typecheck-web.ts",
    "web:build": "tsx scripts/build-web.ts",
    "web:clean": "tsx scripts/clean-web.ts",
    "specialized:install": "tsx scripts/install-specialized.ts",
    "specialized:lint": "tsx scripts/lint-specialized.ts",
    "specialized:build": "tsx scripts/build-specialized.ts",
    "specialized:clean": "tsx scripts/clean-specialized.ts",
    "server:install": "tsx scripts/install-server.ts",
    "server:lint": "tsx scripts/lint-server.ts",
    "server:typecheck": "tsx scripts/typecheck-server.ts",
    "server:build": "tsx scripts/build-server.ts",
    "server:clean": "tsx scripts/clean-server.ts",
    "mobile:install": "tsx scripts/install-mobile.ts",
    "mobile:lint": "tsx scripts/lint-mobile.ts",
    "mobile:typecheck": "tsx scripts/typecheck-mobile.ts",
    "mobile:build": "tsx scripts/build-mobile.ts",
    "mobile:clean": "tsx scripts/clean-mobile.ts",
    "clean:all": "tsx scripts/clean-web.ts && tsx scripts/clean-specialized.ts && tsx scripts/clean-server.ts && tsx scripts/clean-mobile.ts",
    "clean:node_modules": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
    "clean:dist": "find . -path '*/node_modules' -prune -o \\( -name 'dist' -o -name 'build' -o -name '.next' -o -name '.output' -o -name 'coverage' \\) -type d -print -exec rm -rf {} +",
    "clean:yarn": "find . -name 'install-state.gz' -path '*/.yarn/*' -type f -delete 2>/dev/null || true && find . -name 'cache' -path '*/.yarn/*' -type d -exec rm -rf {} + 2>/dev/null || true",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf {} + && find . -path '*/node_modules' -prune -o \\( -name 'dist' -o -name 'build' -o -name '.next' -o -name '.output' -o -name 'coverage' \\) -type d -print -exec rm -rf {} + && find . -name 'install-state.gz' -path '*/.yarn/*' -type f -delete 2>/dev/null || true && find . -name 'cache' -path '*/.yarn/*' -type d -exec rm -rf {} + 2>/dev/null || true",
    "deps:check": "tsx scripts/update-para-dependencies.ts --check-only",
    "deps:update": "tsx scripts/update-para-dependencies.ts",
    "deps:update:diff": "tsx scripts/update-para-dependencies.ts --diff-only",
    "test:all": "tsx e2e/scripts/runAllTests.ts --sequential",
    "test:react-vite": "tsx e2e/scripts/runAllTests.ts react-vite",
    "test:react-vite:email-basic-login": "tsx e2e/scripts/runAllTests.ts react-vite-basic-login email-basic-login",
    "test:react-vite:phone-basic-login": "tsx e2e/scripts/runAllTests.ts react-vite-basic-login phone-basic-login",
    "test:react-vite:email-pin": "tsx e2e/scripts/runAllTests.ts react-vite-pin email-pin",
    "test:react-vite:phone-pin": "tsx e2e/scripts/runAllTests.ts react-vite-pin phone-pin",
    "test:react-vite:email-password": "tsx e2e/scripts/runAllTests.ts react-vite email-password",
    "test:react-vite:email-passkey": "tsx e2e/scripts/runAllTests.ts react-vite email-passkey",
    "test:react-vite:phone-password": "tsx e2e/scripts/runAllTests.ts react-vite phone-password",
    "test:react-vite:phone-passkey": "tsx e2e/scripts/runAllTests.ts react-vite phone-passkey",
    "test:react-nextjs": "tsx e2e/scripts/runAllTests.ts react-nextjs",
    "test:react-nextjs:email-basic-login": "tsx e2e/scripts/runAllTests.ts react-nextjs-basic-login email-basic-login",
    "test:react-nextjs:phone-basic-login": "tsx e2e/scripts/runAllTests.ts react-nextjs-basic-login phone-basic-login",
    "test:react-nextjs:email-pin": "tsx e2e/scripts/runAllTests.ts react-nextjs-pin email-pin",
    "test:react-nextjs:phone-pin": "tsx e2e/scripts/runAllTests.ts react-nextjs-pin phone-pin",
    "test:react-nextjs:email-password": "tsx e2e/scripts/runAllTests.ts react-nextjs email-password",
    "test:react-nextjs:email-passkey": "tsx e2e/scripts/runAllTests.ts react-nextjs email-passkey",
    "test:react-nextjs:phone-password": "tsx e2e/scripts/runAllTests.ts react-nextjs phone-password",
    "test:react-nextjs:phone-passkey": "tsx e2e/scripts/runAllTests.ts react-nextjs phone-passkey",
    "test:vue": "tsx e2e/scripts/runAllTests.ts vue",
    "test:svelte": "tsx e2e/scripts/runAllTests.ts svelte",
    "test:node": "tsx e2e/scripts/runAllTests.ts node",
    "test:web": "tsx e2e/scripts/runAllTests.ts --web",
    "dev:setup": "yarn clean && yarn install:all && yarn build:all",
    "ci:local": "yarn install:all && yarn lint:all && yarn typecheck:all && yarn build:all && yarn test:all:parallel",
    "quality": "yarn lint:all && yarn typecheck:all"
  },
  "packageManager": "yarn@4.10.3"
}
